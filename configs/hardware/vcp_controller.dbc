VERSION "VCP virtual CAN interface"


NS_ :
    NS_DESC_
    CM_
    BA_DEF_
    BA_
    VAL_
    CAT_DEF_
    CAT_
    FILTER
    BA_DEF_DEF_
    EV_DATA_
    ENVVAR_DATA_
    SGTYPE_
    SGTYPE_VAL_
    BA_DEF_SGTYPE_
    BA_SGTYPE_
    SIG_TYPE_REF_
    VAL_TABLE_
    SIG_GROUP_
    SIG_VALTYPE_
    SIGTYPE_VALTYPE_
    BO_TX_BU_
    BA_DEF_REL_
    BA_REL_
    BA_DEF_DEF_REL_
    BU_SG_REL_
    BU_EV_REL_
    BU_BO_REL_
    SG_MUL_VAL_

BS_:

BU_: VCP

BO_ 288 VCP_ControllerStatus: 8 VCP
 SG_ AccelCmd : 0|16@1- (0.001,0) [-32.768|32.767] "m/s^2" VCP
 SG_ SteeringCmd : 16|16@1- (0.0001,0) [-3.2768|3.2767] "rad" VCP
 SG_ SolveTimeMs : 32|16@1+ (0.01,0) [0|655.35] "ms" VCP
 SG_ ControllerMode : 48|8@1+ (1,0) [0|255] "" VCP
 SG_ FallbackReason : 56|8@1+ (1,0) [0|255] "" VCP

CM_ BO_ 288 "Virtual CAN frame for controller command, timing, mode, and fallback status.";
CM_ SG_ 288 AccelCmd "Requested longitudinal acceleration.";
CM_ SG_ 288 SteeringCmd "Requested steering angle.";
CM_ SG_ 288 SolveTimeMs "Controller compute time.";
CM_ SG_ 288 ControllerMode "Controller/safety mode enum.";
CM_ SG_ 288 FallbackReason "Fallback reason enum.";

VAL_ 288 ControllerMode 0 "NORMAL" 1 "DEGRADED" 2 "FALLBACK_BRAKE" 3 "EMERGENCY_STOP" 4 "ESTIMATOR_FAULT" 5 "SOLVER_TIMEOUT" ;
VAL_ 288 FallbackReason 0 "no_fault" 1 "solver_infeasible" 2 "solver_timeout" 3 "estimator_residual" 4 "invalid_command" 5 "collision_risk" 6 "missing_sensor_message" 7 "communication_timeout" 8 "invalid_measurement" ;
